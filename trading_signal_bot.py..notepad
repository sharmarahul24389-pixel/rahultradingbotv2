{"bgColorIndex":0,"textColorIndex":0,"note":"import requests\nimport os\nfrom datetime import datetime, timedelta\nimport time\nfrom flask import Flask, request\nimport json\n\n# ===== CONFIG =====\nALPHA_VANTAGE_API_KEY = \"TPAFZVL2YL2DHJTR\"\nNEWSAPI_KEY = \"f1a70fac140d4e808a6343d0b31830d0\"\nWHATSAPP_API_URL = \"https:\/\/api.whatsapp.com\/send\"\nYOUR_PHONE = \"97155”1460365  # Your WhatsApp number without +971551460365\n\n# Account settings\nACCOUNT_SIZE = 100000\nRISK_PER_TRADE = 150\nTARGET_DAILY = 500\n\n# Assets to monitor\nSTOCKS = [\"AAPL\", \"MSFT\", \"GOOGL\", \"AMZN\", \"TSLA\", \"NVDA\", \"META\"]\nETFS = [\"SPY\", \"QQQ\"]\nCRYPTO = [\"BTC\", \"ETH\"]\nCOMMODITIES = [\"GOLD\", \"SILVER\"]\n\n# ===== FLAG PATTERN DETECTION =====\ndef detect_flag_pattern(prices, volumes):\n    \"\"\"Detect bullish flag patterns\"\"\"\n    if len(prices) < 10:\n        return None\n\n    recent = prices[-10:]\n    vol_recent = volumes[-10:]\n\n    # Flagpole: sharp 5-10% move\n    flagpole_move = ((recent[3] - recent[0]) \/ recent[0]) * 100\n    if flagpole_move < 5:\n        return None\n\n    # Flag: tight consolidation\n    flag_prices = recent[3:8]\n    flag_range = (max(flag_prices) - min(flag_prices)) \/ min(flag_prices) * 100\n    flag_vol = sum(vol_recent[3:8]) \/ 5\n    avg_vol = sum(vol_recent[:3]) \/ 3\n\n    if flag_range > 3 or flag_vol >= avg_vol:\n        return None\n\n    # Breakout: price above flag on volume\n    if recent[-1] > max(flag_prices) and vol_recent[-1] > avg_vol * 1.2:\n        return {\n            \"flagpole\": flagpole_move,\n            \"entry\": recent[-1],\n            \"support\": min(flag_prices),\n            \"target\": recent[-1] + (flagpole_move \/ 100 * recent[-1])\n        }\n\n    return None\n\n# ===== GET LIVE DATA =====\ndef get_stock_data(symbol):\n    \"\"\"Fetch 30-min intraday data from Alpha Vantage\"\"\"\n    url = f\"https:\/\/www.alphavantage.co\/query\"\n    params = {\n        \"function\": \"TIME_SERIES_INTRADAY\",\n        \"symbol\": symbol,\n        \"interval\": \"30min\",\n        \"apikey\": ALPHA_VANTAGE_API_KEY\n    }\n    response = requests.get(url, params=params)\n    data = response.json()\n\n    if \"Time Series (30min)\" not in data:\n        return None, None\n\n    ts = data[\"Time Series (30min)\"]\n    prices = [float(ts[t][\"4. close\"]) for t in list(ts.keys())[:10]]\n    volumes = [float(ts[t][\"5. volume\"]) for t in list(ts.keys())[:10]]\n\n    return prices[::-1], volumes[::-1]\n\n# ===== GET NEWS SENTIMENT =====\ndef get_news_sentiment(symbol):\n    \"\"\"Check if recent news is positive\"\"\"\n    url = \"https:\/\/newsapi.org\/v2\/everything\"\n    params = {\n        \"q\": symbol,\n        \"sortBy\": \"publishedAt\",\n        \"apikey\": NEWSAPI_KEY,\n        \"pageSize\": 5\n    }\n    response = requests.get(url, params=params)\n    articles = response.json().get(\"articles\", [])\n\n    if not articles:\n        return \"neutral\"\n\n    # Simple sentiment: check if titles have positive words\n    positive_words = [\"surge\", \"rally\", \"beat\", \"rise\", \"gain\", \"up\", \"strong\", \"bullish\"]\n    negative_words = [\"crash\", \"fall\", \"miss\", \"drop\", \"loss\", \"down\", \"weak\", \"bearish\"]\n\n    recent_title = articles[0][\"title\"].lower()\n\n    if any(word in recent_title for word in positive_words):\n        return \"positive\"\n    elif any(word in recent_title for word in negative_words):\n        return \"negative\"\n\n    return \"neutral\"\n\n# ===== SEND WHATSAPP ALERT =====\ndef send_whatsapp_alert(symbol, entry, stop, target, sentiment):\n    \"\"\"Send WhatsApp signal via simple message\"\"\"\n    message = f\"🚨 SIGNAL ALERT\\n\\nSymbol: {symbol}\\nEntry: ${entry:.2f}\\nStop Loss: ${stop:.2f}\\nTarget: ${target:.2f}\\nSentiment: {sentiment}\\n\\nRisk: $150 | Target: $500\"\n\n    # For now, print signal (in production, use WhatsApp API)\n    print(f\"\\n{'='*50}\")\n    print(message)\n    print(f\"{'='*50}\\n\")\n\n    return True\n\n# ===== MAIN SCANNER =====\ndef scan_for_signals():\n    \"\"\"Main scanning function\"\"\"\n    all_assets = STOCKS + ETFS + CRYPTO + COMMODITIES\n\n    for asset in all_assets:\n        prices, volumes = get_stock_data(asset)\n\n        if prices is None:\n            continue\n\n        signal = detect_flag_pattern(prices, volumes)\n\n        if signal:\n            sentiment = get_news_sentiment(asset)\n\n            # Only alert if sentiment is positive or neutral (skip negative news)\n            if sentiment != \"negative\":\n                send_whatsapp_alert(\n                    asset,\n                    signal[\"entry\"],\n                    signal[\"support\"],\n                    signal[\"target\"],\n                    sentiment\n                )\n\n        time.sleep(1)  # Avoid rate limiting\n\n# ===== FLASK APP FOR HEROKU =====\napp = Flask(__name__)\n\n@app.route('\/')\ndef home():\n    return \"Trading Bot is running!\"\n\n@app.route('\/scan', methods=['GET'])\ndef trigger_scan():\n    scan_for_signals()\n    return \"Scan completed!\"\n\nif __name__ == '__main__':\n    port = int(os.environ.get('PORT', 5000))\n    app.run(host='0.0.0.0'...\n"}